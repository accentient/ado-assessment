# https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Matches .gitattributes
[*.{ps1,psm1,psd1}]
end_of_line = crlf

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false
