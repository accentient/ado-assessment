# Normalize line endings in the repository and check out with the platform default.
* text=auto

# PowerShell files check out with CRLF on every OS, so Authenticode signatures and
# Windows tooling see the same bytes everywhere.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.pdf  binary
